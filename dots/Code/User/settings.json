{
    "[c]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    },
    "[tex]": {
        "editor.defaultFormatter": "James-Yu.latex-workshop"
    },
    "animations.Active": "Indent",
    "animations.Install-Method": "Custom CSS and JS",
    "chat.disableAIFeatures": true,
    "chat.fontFamily": "ComicShannsMono Nerd Font",
    "chat.tips.enabled": false,
    "chat.viewSessions.orientation": "stacked",
    "clang-format.style": "{IndentWidth: 4}",
    "claudeCode.preferredLocation": "sidebar",
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.inlineSuggest.enabled": false,
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": false,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.wordWrap": "on",
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "explorer.sortOrder": "type",
    "files.autoSave": "onFocusChange",
    "geminicodeassist.project": "lunar-tranquility-jfjjl",
    "http.systemCertificatesNode": true,
    "java.help.showReleaseNotes": false,
    "json.schemaDownload.trustedDomains": {
        "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json": true
    },
    "latex-workshop.formatting.latex": "latexindent",
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.autoClean.run": "onBuilt",
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.bbl",
        "*.blg",
        "*.idx",
        "*.ind",
        "*.lof",
        "*.lot",
        "*.out",
        "*.toc",
        "*.acn",
        "*.acr",
        "*.alg",
        "*.glg",
        "*.glo",
        "*.gls",
        "*.fls",
        "*.log",
        "*.fdb_latexmk",
        "*.snm",
        "*.synctex.gz",
        "*.nav",
        "*.vrb",
        "*.xdv",
        "*.bcf",
        "*.run.xml"
    ],
    "latex-workshop.latex.clean.subfolder.enabled": true,
    "latex-workshop.latex.rootFile.useSubFile": false,
    "python.createEnvironment.trigger": "off",
    "redhat.telemetry.enabled": false,
    "search.quickOpen.includeHistory": false,
    "telemetry.editStats.enabled": false,
    "telemetry.feedback.enabled": false,
    "telemetry.telemetryLevel": "off",
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorStyleInactive": "line",
    "terminal.integrated.inheritEnv": false,
    "terminal.integrated.stickyScroll.enabled": false,
    "update.showReleaseNotes": false,
    "vscode_custom_css.imports": [
        "file:///home/keqingsimp/.config/Code/ui.css",
        "file:///home/keqingsimp/.config/Code/script.js",
        "file:///home/keqingsimp/.vscode/extensions/brandonkirbyson.vscode-animations-2.0.9/dist/updateHandler.js"
    ],
    "window.commandCenter": false,
    "window.menuBarVisibility": "toggle",
    "window.title": "${dirty}${rootNameShort}",
    "window.zoomLevel": 3,
    "workbench.activityBar.location": "hidden",
    "workbench.browser.showInTitleBar": false,
    "workbench.colorCustomizations": {
        "[Dark Modern]": {
            "activityBar.background": "#000000",
            "breadcrumb.background": "#000000",
            "editor.background": "#000000",
            "editorGroupHeader.tabsBackground": "#000000",
            "panel.background": "#000000",
            "sideBar.background": "#000000",
            "statusBar.background": "#000000",
            "tab.activeBackground": "#000000",
            "tab.inactiveBackground": "#000000",
            "terminal.background": "#000000",
            "titleBar.activeBackground": "#000000",
            "titleBar.inactiveBackground": "#000000"
        }
    },
    "workbench.colorTheme": "Dark Modern",
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.editor.showTabs": "none",
    "workbench.editor.useModal": "off",
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.md": "vscode.markdown.preview.editor",
        "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default"
    },
    "workbench.layoutControl.enabled": false,
    "workbench.openInAgents.enabled": false,
    "workbench.productIconTheme": "fluent-icons",
    "workbench.startupEditor": "none",
    "workbench.statusBar.visible": false,
    "workbench.tips.enabled": false,
    "workbench.welcomePage.experimentalOnboarding": false,
    "workbench.welcomePage.walkthroughs.openOnInstall": false,
    "animations.Enabled": true,
    "workbench.iconTheme": "symbols",
    "claudeCode.hideOnboarding": true
}